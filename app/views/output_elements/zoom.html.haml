#zoomed_chart
  %h2= raw t "output_elements.#{@chart.key}.title"

  #zoomed_chart_wrapper

  :javascript
    $(function(){
      App.charts.load(#{@chart.key.to_json}, null, {
        wrapper: '#zoomed_chart_wrapper',
        prunable: true,
        force: true,
        header: false,
        as_table: #{@as_table}
      });
    });
