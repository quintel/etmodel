- release_date = ETModel::Version.date
- if release_date && !release_date.future? && scenario.updated_at && scenario.updated_at < release_date
  .version-warning
    = previous_version_scenario_warning(scenario, release_date)
    %details
      %summary= t('scenario.warning.effect')
      %dl
        %dt= t('scenario.warning.slider_changes_header')
        %dd= t('scenario.warning.slider_changes_explanation')
        %dt= t('scenario.warning.outcomes_header')
        %dd= t('scenario.warning.outcomes_explanation')
    .links
      = link_to("#{t('scenario.warning.view_releases')} →", releases_url, target: '_blank', rel: 'noopener noreferrer')
